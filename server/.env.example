# Copy this file to server/.env and fill in the values from the
# "Connections" section of your Render Postgres dashboard.
PGUSER="{Username}"
PGPASSWORD="{Password}"
PGHOST="{Hostname}.oregon-postgres.render.com"
PGPORT=5432
PGDATABASE="{Database}"

# Render requires SSL (the default). Set this to false only for a local Postgres.
# PGSSL=false
